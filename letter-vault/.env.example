# Letter Vault — environment variable names only
# Copy to worker/.dev.vars for local dev. Never commit real values.

# Cloudflare Worker secrets (set via: wrangler secret put NAME --env staging)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# 32 random bytes, base64 — generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LETTER_VAULT_MASTER_KEY_V1=your-base64-master-key-here
LETTER_VAULT_STAGING_ADMIN_TOKEN=your-staging-admin-token-here
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Non-secret (set in wrangler.toml [vars])
# VAULT_ENV=staging | development
